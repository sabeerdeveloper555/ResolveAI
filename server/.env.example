# Backend environment configuration.
# Copy this file to server/.env and fill in real values.
# Never commit a populated .env: root .gitignore keeps .env out of Git.

# PostgreSQL connection string for the Supabase database (privileged pg.Pool).
# Contains credentials, so it is intentionally left blank here.
DATABASE_URL=

# Port the Express API listens on (defaults to 5000 when unset).
PORT=5000

# Supabase JWT verification (PUBLIC values only — no secrets).
# The backend verifies access tokens against the project's public JWKS and
# rejects any token whose issuer/audience/algorithm/lifetime does not match.
# These two variables are required: the server fails to start without them.
SUPABASE_JWKS_URL=https://fcvqitqavawyfntaiuzl.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_ISSUER=https://fcvqitqavawyfntaiuzl.supabase.co/auth/v1

# Notes:
#   - Expected audience is fixed to "authenticated" and algorithm to ES256 in
#     code, so they are not configurable here.
#   - SUPABASE_JWT_ISSUER must NOT end with a trailing slash.
