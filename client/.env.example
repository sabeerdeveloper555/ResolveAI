# Base URL of the ResolveAI backend API (server/).
# The frontend falls back to http://localhost:5000 when this is not set.
VITE_API_BASE_URL=http://localhost:5000

# Supabase Auth (frontend only). Copy this file to client/.env and fill in
# values from the Supabase Dashboard → Project Settings → API.
# Use the PUBLISHABLE (anon) key only. Never put secret keys, service-role
# keys, JWT signing secrets or database URLs in frontend environment files.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-publishable-key
